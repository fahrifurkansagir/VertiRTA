<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vertirta_bringup</name>
  <version>1.0.0</version>
  <description>ROS 2 Jazzy SITL launch bringup for VertiRTA-X8-240 (Foxglove :8891, MicroXRCEAgent :8888)</description>
  <maintainer email="fahrifurkansagir@users.noreply.github.com">Fahri Furkan Sagir</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>vertirta_msgs</exec_depend>
  <exec_depend>vertirta_px4_bridge</exec_depend>
  <exec_depend>vertirta_rta_node</exec_depend>
  <exec_depend>vertirta_map_node</exec_depend>
  <exec_depend>vertirta_fault_injector</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
