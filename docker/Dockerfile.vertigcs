# SPDX-License-Identifier: Apache-2.0
# 3-stage non-root build: single-threaded Emscripten WASM (<150 KiB) -> Vite VertiGCS -> unprivileged Nginx (:5180)

FROM emscripten/emsdk:4.0.4 AS wasm-builder

RUN apt-get update && apt-get install -y --no-install-recommends ninja-build git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY core/flight_core ./core/flight_core
COPY wasm ./wasm

RUN bash wasm/build_wasm.sh /out/wasm /tmp/wasm_build

FROM node:22-bookworm-slim AS web-builder

WORKDIR /app
COPY apps/vertigcs/package.json apps/vertigcs/package-lock.json apps/vertigcs/tsconfig.json apps/vertigcs/vite.config.ts apps/vertigcs/vitest.config.ts apps/vertigcs/index.html ./
COPY apps/vertigcs/src ./src
COPY apps/vertigcs/public ./public
COPY --from=wasm-builder /out/wasm ./public/wasm

RUN npm ci --no-audit --no-fund && npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY docker/nginx.vertigcs.conf /etc/nginx/conf.d/default.conf
COPY --from=web-builder /app/dist /usr/share/nginx/html

USER 101
EXPOSE 5180
