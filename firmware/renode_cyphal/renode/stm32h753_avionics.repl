// SPDX-License-Identifier: Apache-2.0
// VertiRTA STM32H753 Avionics Renode v1.17.0 Platform Overlay (DR-08 Sec 2.1).
//
// Tier-1 Functional & Protocol SIL ONLY — NOT hardware Cortex-M7 WCET.
// Extends upstream platforms/cpus/stm32h753.repl (which already declares ITCM 64 KB,
// DTCM 128 KB, AXI_SRAM 512 KB, SRAM1 128 KB, FDCAN1 @ 0x4000A000, canMessageRAM @ 0x4000AC00)
// and fixes documented upstream STM32H7 gaps:
//   1. Custom Miscellaneous.STM32H7_PWR at 0x58024800 (resolves renode#649, renode#857 VOSRDY hang)
//   2. Explicit nvic systickFrequency: 480_000_000 (resolves renode#1009 static timer clock)
//   3. DBGMCU->IDCODE Tag returning Rev V (0x20030450) so VOS0 + FDCAN safety interlock passes

using "platforms/cpus/stm32h753.repl"

nvic:
    systickFrequency: 480000000

// Replace default PWR stub with custom C# model (loaded via dual_fcc_failover.resc).
pwr: @ none
pwrH7: Miscellaneous.STM32H7_PWR @ sysbus 0x58024800

// Expose STM32H753 Rev V (REV_ID = 0x2003, DEV_ID = 0x0450) at DBGMCU->IDCODE (0x5C001000).
sysbus:
    init:
        Tag <0x5C001000 0x4> "DBGMCU_IDCODE_REV_V" 0x20030450
