diff --git a/src/modules/simulation/gz_bridge/GZMixingInterfaceESC.cpp b/src/modules/simulation/gz_bridge/GZMixingInterfaceESC.cpp
--- a/src/modules/simulation/gz_bridge/GZMixingInterfaceESC.cpp
+++ b/src/modules/simulation/gz_bridge/GZMixingInterfaceESC.cpp
@@ -88,9 +88,37 @@
 bool GZMixingInterfaceESC::updateOutputs(float outputs[MAX_ACTUATORS], unsigned num_outputs, unsigned num_control_groups_updated)
 {
+	// Part (d): Poll VEHICLE_CMD_INJECT_FAILURE for motor cuts (GZ Harmonic parity with Gazebo Classic)
+	vehicle_command_s cmd{};
+	while (_failure_injection_sub.update(&cmd)) {
+		if (cmd.command == vehicle_command_s::VEHICLE_CMD_INJECT_FAILURE &&
+		    static_cast<int>(cmd.param1) == vehicle_command_s::FAILURE_UNIT_SYSTEM_MOTOR) {
+			const int ftype = static_cast<int>(cmd.param2);
+			const int instance = static_cast<int>(cmd.param3); // 0 = all, 1..N = 1-indexed motor
+			const bool cut = (ftype == vehicle_command_s::FAILURE_TYPE_OFF);
+			const bool restore = (ftype == vehicle_command_s::FAILURE_TYPE_OK);
+			if (cut || restore) {
+				if (instance == 0) {
+					_motor_failure_mask = cut ? 0xFFFFu : 0x0000u;
+				} else if (instance >= 1 && instance <= static_cast<int>(MAX_ACTUATORS)) {
+					const uint16_t bit = static_cast<uint16_t>(1u << (instance - 1));
+					if (cut) {
+						_motor_failure_mask |= bit;
+					} else {
+						_motor_failure_mask &= static_cast<uint16_t>(~bit);
+					}
+				}
+			}
+		}
+	}
+
 	gz::msgs::Actuators actuators_msg;
 	actuators_msg.mutable_velocity()->Resize(num_outputs, 0);
 	for (unsigned i = 0; i < num_outputs; ++i) {
-		actuators_msg.mutable_velocity()->Set(i, outputs[i]);
+		if ((_motor_failure_mask & static_cast<uint16_t>(1u << i)) != 0u) {
+			actuators_msg.mutable_velocity()->Set(i, 0.0);
+		} else {
+			actuators_msg.mutable_velocity()->Set(i, outputs[i]);
+		}
 	}
 	return _actuators_pub.Publish(actuators_msg);
 }
