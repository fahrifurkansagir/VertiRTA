{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev-linux-x64",
      "displayName": "Dev Linux (RelWithDebInfo, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-linux-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VERTIRTA_BUILD_COMPANION": "ON",
        "VERTIRTA_BUILD_TESTS": "ON",
        "VERTIRTA_ENABLE_STRICT_FP": "ON"
      }
    },
    {
      "name": "release-linux-x64",
      "displayName": "Release Linux (O2 Strict-FP, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-linux-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VERTIRTA_BUILD_COMPANION": "ON",
        "VERTIRTA_BUILD_TESTS": "ON",
        "VERTIRTA_ENABLE_STRICT_FP": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Address + UndefinedBehavior Sanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "VERTIRTA_BUILD_COMPANION": "ON",
        "VERTIRTA_BUILD_TESTS": "ON",
        "VERTIRTA_ENABLE_STRICT_FP": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "VERTIRTA_BUILD_COMPANION": "ON",
        "VERTIRTA_BUILD_TESTS": "ON",
        "VERTIRTA_ENABLE_STRICT_FP": "ON"
      }
    },
    {
      "name": "arm-cortex-m7",
      "displayName": "Bare-Metal ARM Cortex-M7 (STM32H753 FPv5-D16)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm-cortex-m7",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Generic",
        "CMAKE_SYSTEM_PROCESSOR": "arm",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "CMAKE_C_COMPILER": "arm-none-eabi-gcc",
        "CMAKE_CXX_COMPILER": "arm-none-eabi-g++",
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_C_FLAGS": "-mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=hard -Os",
        "CMAKE_CXX_FLAGS": "-mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=hard -Os",
        "VERTIRTA_BUILD_COMPANION": "OFF",
        "VERTIRTA_BUILD_TESTS": "OFF",
        "VERTIRTA_ENABLE_STRICT_FP": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev-linux-x64", "configurePreset": "dev-linux-x64" },
    { "name": "release-linux-x64", "configurePreset": "release-linux-x64" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "arm-cortex-m7", "configurePreset": "arm-cortex-m7" }
  ],
  "testPresets": [
    { "name": "dev-linux-x64", "configurePreset": "dev-linux-x64", "output": { "outputOnFailure": true } },
    { "name": "release-linux-x64", "configurePreset": "release-linux-x64", "output": { "outputOnFailure": true } },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } }
  ]
}
