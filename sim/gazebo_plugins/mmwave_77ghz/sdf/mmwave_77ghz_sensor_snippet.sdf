<!-- VertiRTA M3 (v4.0.0) Gazebo Harmonic 77 GHz 4D mmWave Imaging Radar Sensor Snippet -->
<sdf version="1.11" xmlns:gz="http://gazebosim.org/schema">
  <sensor name="vertirta_mmwave_77ghz" type="custom" gz:type="mmwave_77ghz">
    <pose>0.65 0.0 0.08 0 0 0</pose>
    <always_on>true</always_on>
    <update_rate>20</update_rate>
    <topic>/vertirta/mmwave_77ghz/detections</topic>
    <gz:mmwave_77ghz>
      <profile>tier1b_cascaded_mimo</profile>
      <carrier_hz>77000000000</carrier_hz>
      <tx_power_dbm>13.0</tx_power_dbm>
      <antenna_gain_dbi>16.0</antenna_gain_dbi>
      <virtual_channels>192</virtual_channels>
      <cpi_duration_s>0.020</cpi_duration_s>
      <noise_figure_db>12.0</noise_figure_db>
      <system_loss_db>9.1</system_loss_db>
      <fov_az_half_deg>45.0</fov_az_half_deg>
      <fov_el_half_deg>20.0</fov_el_half_deg>
      <max_range_m>150.0</max_range_m>
      <grazing_cliff_deg>20.0</grazing_cliff_deg>
      <swerling_model>swerling_1</swerling_model>
    </gz:mmwave_77ghz>
  </sensor>
</sdf>
