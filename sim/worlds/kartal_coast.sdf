<?xml version="1.0" encoding="UTF-8"?>
<!--
  VertiRTA Maltepe-Dragos-Kartal Coastal Corridor World (Gazebo Harmonic / SDF 1.9)
  Single-Source-of-Truth: config/istanbul_ltfj_airspace.yaml (Spec v1.2 + DR-1/DR-5 Locks)

  CRITICAL GLOBAL PLUGIN LOCK (DR-1 Section 5.1):
    PX4 v1.16's src/modules/simulation/gz_bridge/server.config loads all standard Gazebo
    Harmonic global systems (physics, user-commands, scene-broadcaster, contact, imu,
    air-pressure, navsat, magnetometer, wind-effects, sensors/ogre2).
    DO NOT add duplicate global gz-sim-*-system <plugin> blocks to this world SDF!

  CRITICAL NAVSAT GEOID DATUM LOCK (Review Focus #5 / DR-1 Erratum #4):
    PX4 v1.16 GZBridge::navSatCallback maps Gazebo NavSat msg.altitude() directly into
    sensor_gps.altitude_msl_m (AMSL) without subtracting EGM2008 geoid undulation (+36.7 m).
    Therefore <spherical_coordinates><elevation> MUST be locked to Kartal Coastal Vertiport
    AMSL elevation (12.0 m), NOT HAE (48.7 m). Adding +36.7 m EGM2008 ONCE inside
    vertirta::core::amsl_to_hae() yields exact 48.7 m HAE (preventing +36.7 m EKF2
    double-addition to 85.4 m HAE against LTFJ 798.58 m HAE / LTBX 646.35 m HAE ceilings).
-->
<sdf version="1.9">
  <world name="kartal_coast">
    <!-- 400 Hz Lockstep Physics synchronized with PX4 IMU_INTEG_RATE=400 & mc_indi_wls_control -->
    <physics name="vertirta_400hz" type="dart">
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>400</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.80665</gravity>
    <!-- Istanbul Kartal local geomagnetic field in ENU (+6.15 deg E declination, ~47.2 uT) -->
    <magnetic_field>2.656e-6 2.466e-5 -4.016e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- Kartal Coastal Vertiport Datum: 40.8860 N, 29.1880 E, 12.0 m AMSL (+36.7 m EGM2008 = 48.7 m HAE) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>40.8860</latitude_deg>
      <longitude_deg>29.1880</longitude_deg>
      <elevation>12.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- Custom MIL-F-8785C Tustin Dryden Coastal Wind Plugin (non-conflicting with PX4 server.config) -->
    <plugin filename="libvertirta_dryden_wind.so" name="vertirta_gz::VertirtaDrydenWindSystem">
      <w20_mps>7.72</w20_mps>
      <mean_wind_mps>4.0</mean_wind_mps>
      <mean_wind_dir_deg>215.0</mean_wind_dir_deg>
      <seed>42</seed>
      <cd_a_xy_m2>0.48</cd_a_xy_m2>
      <cd_a_z_m2>1.20</cd_a_z_m2>
      <target_model>vertirta_x8_240</target_model>
      <target_link>base_link</target_link>
      <wind_topic>/vertirta/wind_world_enu</wind_topic>
    </plugin>

    <scene>
      <ambient>0.55 0.58 0.62 1</ambient>
      <background>0.68 0.80 0.92 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="marmara_sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.88 0.84 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>

    <!-- Coastal Ground Plane (z = 0 m corresponds to 12.0 m AMSL / 48.7 m HAE) -->
    <model name="kartal_ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12000 12000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12000 12000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.32 0.36 0.34 1</ambient>
            <diffuse>0.42 0.46 0.44 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- SLZ-01: Kartal Coastal Vertiport Landing Pad (R = 15.0 m, slope <= 1.5 deg) -->
    <model name="kartal_slz_pad">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="pad_link">
        <visual name="pad_disc">
          <geometry>
            <cylinder><radius>15.0</radius><length>0.02</length></cylinder>
          </geometry>
          <material>
            <ambient>0.22 0.24 0.26 1</ambient>
            <diffuse>0.28 0.30 0.33 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Coastal Clutter / Mid-Rise Building Obstacles (West of LTFJ J2 CTR boundary) -->
    <model name="kartal_coastal_tower_west">
      <static>true</static>
      <pose>-48.0 35.0 16.0 0 0 0</pose>
      <link name="tower_link">
        <collision name="tower_col">
          <geometry><box><size>16.0 18.0 32.0</size></box></geometry>
        </collision>
        <visual name="tower_vis">
          <geometry><box><size>16.0 18.0 32.0</size></box></geometry>
          <material><diffuse>0.65 0.63 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="kartal_coastal_wire_pylon_a">
      <static>true</static>
      <pose>-25.0 55.0 12.0 0 0 0</pose>
      <link name="pylon_a_link">
        <collision name="pylon_a_col">
          <geometry><cylinder><radius>0.45</radius><length>24.0</length></cylinder></geometry>
        </collision>
        <visual name="pylon_a_vis">
          <geometry><cylinder><radius>0.45</radius><length>24.0</length></cylinder></geometry>
          <material><diffuse>0.45 0.48 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="kartal_coastal_wire_pylon_b">
      <static>true</static>
      <pose>-25.0 95.0 12.0 0 0 0</pose>
      <link name="pylon_b_link">
        <collision name="pylon_b_col">
          <geometry><cylinder><radius>0.45</radius><length>24.0</length></cylinder></geometry>
        </collision>
        <visual name="pylon_b_vis">
          <geometry><cylinder><radius>0.45</radius><length>24.0</length></cylinder></geometry>
          <material><diffuse>0.45 0.48 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
